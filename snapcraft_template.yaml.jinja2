name: husarion-depthai
title: Husarion DepthAI
adopt-info: husarion-depthai
license: Apache-2.0
summary: OAK-x cameras driver for Husarion robots
icon: snap/gui/icon.png
description: |
  ROS 2 driver for Luxonis OAK-x depth cameras on Husarion robots. Publishes RGB (raw + on-chip H.264 — hardware-encoded, ~0 host CPU) and, when enabled, depth + a point cloud.

  **Installation**

     sudo snap install husarion-depthai
     sudo /var/snap/husarion-depthai/common/post_install.sh
     sudo snap set husarion-depthai driver.model=OAK-D-PRO
     sudo husarion-depthai.start

  `post_install.sh` connects the interfaces snapd doesn't auto-connect on sideloaded installs. `driver.model` is required before start (hardware is autodetected; this is validation/cockpit metadata).

  **Camera settings** (`sudo snap set husarion-depthai <key>=<value>`)

  * `driver.depth=true` — adds metric depth + an on-chip H.264 disparity preview. Needs a stereo OAK (rejected on OAK-1/OAK-1-LITE).
  * `driver.pointcloud=true` — publishes a `/points` point cloud (implies `depth=true`).
  * `driver.resolution` (`720P`/`1080P`/`4K`, default `720P`) and `driver.fps` (1-60, default `30`) — RGB resolution/framerate.
  * `driver.imu=true` — enable the IMU, on models that have one.
  * `driver.ir=true` — enable the IR laser dot projector + floodlight (OAK-D-PRO/-W only).
  * `driver.ip=<address>` — PoE camera's IP address; leave unset for USB.
  * `driver.rectify-rgb=false` — skip rectification to save CPU (raw image is always published regardless).
  * `driver.name`, `driver.startup-delay` — node name / topic prefix; USB cold-start delay after a fresh reboot.

  Every setting above is checked against the declared camera model — an unsupported combination (e.g. depth on an OAK-1) is rejected immediately with a clear reason, never a silent failure at runtime.

  **ROS network**: `ros.namespace`, `ros.domain-id`, `ros.transport` (`udp`/`shm`/`udp-lo`, `fastdds/<name>`, `cyclonedds/<name>`, `rmw_cyclonedds_cpp`).

  **Husarion cockpit integration**

  Installed alongside a `rosbot` snap, this joins its agent chain automatically and inherits ROS network config (RMW incl. Zenoh, domain, namespace) from the cockpit **Manage** tab — the Camera card there exposes the same `driver.*` keys as fields. When chained, don't set `ros.transport` locally. Sideloaded installs need `snap connect husarion-depthai:agent-chain rosbot:agent-chain` once.

  Full parameter reference, custom camera presets, and architecture notes: see the project README.

grade: stable
confinement: strict
base: core24
# Content interface + same-publisher auto-connect for zero-config snap chaining
# (SPEC-content-chain).
assumes: [snapd2.43]

# Chained-agents leaf follower of the rosbot snap's cascading primary on :7444.
# No HA_PEER_BIND (no downstream subscribers).
environment:
  HA_TIER: "robot"

contact: https://github.com/husarion/depthai-snap/issues
issues: https://github.com/husarion/depthai-snap/issues
source-code: https://github.com/husarion/husarion-depthai-snap
website: https://husarion.com/

slots:
  shm-slot:
    interface: shared-memory
    write: ['*'] # paths are relative to /dev/shm

plugs:
  shm-plug:
    interface: shared-memory
    shared-memory: shm-slot
    private: false
  # Chaining (SPEC-content-chain) is opt-in, not auto-installed: no
  # `default-provider`, so installing this snap never pulls in `rosbot` from
  # the store. If a `rosbot` snap is present and you want this depthai snap to
  # join its agent chain, connect manually:
  #   sudo snap connect husarion-depthai:agent-chain rosbot:agent-chain
  # connect-plug-agent-chain then self-joins via the CSR drop-box.
  agent-chain:
    interface: content
    content: husarion-agent-chain
    target: $SNAP_COMMON/agent-chain-upstream

apps:

  daemon:
    command: usr/bin/launcher.sh
    command-chain: [usr/bin/ros_setup.sh]
    daemon: simple
    install-mode: disable   # disabled until driver.model is set; enabled by `husarion-depthai.start`
    restart-condition: always
    plugs: [network, network-bind, shm-plug, raw-usb, hardware-observe]
    slots: [shm-slot]
    extensions: [ros2-{{ ros_distro }}-ros-base]

  husarion-depthai:
    command: usr/bin/launcher.sh
    command-chain: [usr/bin/check_daemon_running.sh, usr/bin/ros_setup.sh]
    plugs: [network, network-bind, shm-plug, raw-usb, hardware-observe]
    slots: [shm-slot]
    extensions: [ros2-{{ ros_distro }}-ros-base]

  start:
    command: usr/bin/start_launcher.sh

  restart:
    command: usr/bin/restart_launcher.sh

  stop:
    command: usr/bin/stop_launcher.sh

  # Chained-agents leaf follower. Subscribes to the rosbot snap's cascading
  # primary on :7444 (which follows the cockpit BIC on :7443). A network change
  # cascades cockpit BIC → rosbot → husarion-depthai (no listener); the seeded
  # hooks/network calls `snapctl set ros.<key>` against this snap's own config.
  husarion-agent:
    command: usr/bin/husarion_agent_launcher.sh
    daemon: simple
    install-mode: enable
    restart-condition: always
    plugs: [network, network-bind]

  peer-join:
    command: usr/bin/husarion-agent
    plugs: [network]

parts:

  # Stages depthai-ros (+ supporting ROS packages) via apt AND builds our custom
  # depthai_ros_driver pipeline plugin (pluginlib) against them in the SAME part —
  # RGB raw + on-chip-H.264 dual output (RGBDual) + RGB+depth dual (RGBDDual,
  # toggled by driver.depth). Primed into /opt/ros/{{ ros_distro }} so the driver's
  # class loader autoloads it — generate_camera_params.sh (run by the configure
  # hook) always sets camera.i_pipeline_type to RGBDual or RGBDDual, never a stock
  # type. Verified live via `snap try`.
  #
  # One part, not two (was two until 2026-08): `ros-{{ ros_distro }}-depthai-ros`
  # below already transitively apt-depends on depthai/depthai-bridge/
  # depthai-ros-driver/camera-info-manager (verified with `apt-cache depends
  # --recurse`) — a separate `husarion-depthai-pipeline` part's own build-packages
  # list for those was fully redundant, and worse, resolved the same
  # libopencv-imgcodecs -> libgdal -> libpq5 chain a second time via a second apt
  # run that could land on a different snapshot than this part's, tripping
  # snapcraft's "different contents or permissions" staging conflict (hit 2026-08).
  # Merging removes the second resolution entirely instead of excluding one copy.
  husarion-depthai:
    plugin: colcon
    source: ros/
    source-type: local
    colcon-packages: [husarion_depthai_pipeline]
    stage-packages:
      - ros-{{ ros_distro }}-depthai-ros
      - ros-{{ ros_distro }}-image-transport
      - ros-{{ ros_distro }}-image-transport-plugins
      # Two SEPARATE things need ffmpeg_image_transport_msgs/FFMPEGPacket support here:
      #  1. On-chip H.264 (image_raw, always on): husarion_depthai_pipeline builds these
      #     messages itself from the OAK VPU's bitstream — needs only the MESSAGE
      #     package, not the actual encoder plugin. Near-zero host CPU.
      #  2. Rectified RGB (image_rect, image_proc::RectifyNode): the on-chip encoder
      #     taps the RAW pre-rectification frame ONLY — there is no hardware path for
      #     an encoded RECTIFIED stream. The real ffmpeg_image_transport PLUGIN (host
      #     CPU, ~127% of a core) is the only way to get one, hence it's staged too
      #     (removed then re-added 2026-08 — see CLAUDE.md "ffmpeg_image_transport for
      #     image_rect"). See ffmpeg-params-default.yaml for its config.
      # https://index.ros.org/p/ffmpeg_image_transport/github-ros-misc-utilities-ffmpeg_image_transport/#jazzy
      - ros-{{ ros_distro }}-ffmpeg-image-transport
      - ffmpeg
      - ros-{{ ros_distro }}-ffmpeg-image-transport-msgs
      - ros-{{ ros_distro }}-cv-bridge
      - ros-{{ ros_distro }}-rmw-fastrtps-cpp
      - ros-{{ ros_distro }}-rmw-cyclonedds-cpp
      - ros-{{ ros_distro }}-rmw-zenoh-cpp
      # needed to run ffmpeg without errors:
      - libpulse-dev
      - libblas3
      - libjpeg-turbo8-dev
    override-stage: |
      craftctl default
      # Upstream release + build date. The apt Candidate's `-1noble.<timestamp>` tail is
      # buildfarm noise that also shifts between the two arch runners when their apt
      # caches differ; build_date is injected once per CI run so both arches agree.
      upstream="$(apt-cache policy ros-{{ ros_distro }}-depthai-ros-driver \
                   | grep Candidate | awk '{print $2}' | sed -E 's/-[0-9].*$//')"
      case "$upstream" in [0-9]*) ;; *) upstream="unknown" ;; esac
      craftctl set version="${upstream}-{{ build_date }}"
      craftctl set grade="stable"

  local-files:
    plugin: dump
    source: snap/local/
    organize:
      '*.sh': usr/bin/
      '*.py': usr/bin/
      # Only ffmpeg-params-default.yaml lands here — camera-params-autogenerated.yaml
      # is written straight to $SNAP_DATA at runtime by generate_camera_params.sh,
      # never bundled in the snap itself.
      '*.yaml': usr/share/husarion-depthai/config/
      'AGENTS.md': usr/share/husarion-depthai/AGENTS.md
      # '*.xml': usr/share/husarion-depthai/config/
      # '*.json': usr/share/husarion-depthai/config/

  husarion-snap-common:
    plugin: dump
    # TEMP: staging branch combining every husarion-snap-common fix pending
    # upstream merge (husarion/husarion-snap-common PRs #6, #7, #9, #10 — the
    # last two also cover #8, cherry-picked into #10): factory ros.env
    # hardcoded another snap's path; rmw/ tree wasn't self-healing on
    # `snap refresh` across the 0.5.0→0.6.0 layout change; ROS_LOCALHOST_ONLY
    # kept exporting on jazzy instead of translating to
    # ROS_AUTOMATIC_DISCOVERY_RANGE; launcher.sh's `cp -a` EPERM'd under
    # strict confinement (needs CAP_CHOWN it doesn't have); launcher.sh never
    # pointed --advisories-* at snap-safe paths, so husarion-agent boot-looped
    # reading /etc/husarion-agent/advisories.d under AppArmor confinement and
    # never reached its peer follow-task — ROS_NAMESPACE never cascaded into
    # the snap (HW 2026-08-26 on rosbot). None of these are merged/tagged
    # upstream yet; points at the fork branch carrying all of them so CI can
    # still fetch it. Once merged and tagged, switch back to
    # `source: https://github.com/husarion/husarion-snap-common` +
    # `source-tag: "<new tag>"` + `source-type: git`.
    source: https://github.com/rafal-gorecki/husarion-snap-common
    source-branch: fix/husarion-snap-common-pending-fixes
    source-type: git
    build-environment:
      - YQ_VERSION: "v4.35.1"
    build-packages:
      - curl
    organize:
      'local-ros/*.sh': usr/bin/
      'local-ros/rmw/fastdds/*.xml': usr/share/husarion-snap-common/config/rmw/fastdds/
      'local-ros/rmw/cyclonedds/*.xml': usr/share/husarion-snap-common/config/rmw/cyclonedds/
      'local-ros/rmw/zenoh/*.json5': usr/share/husarion-snap-common/config/rmw/zenoh/
      'local-ros/rmw/zenoh-router/*.json5': usr/share/husarion-snap-common/config/rmw/zenoh-router/
      'local-ros/ros.env': usr/share/husarion-snap-common/config/
      # husarion-agent shared substrate (files-first): fetch-binary.sh (build-time,
      # consumed by the husarion-agent part) + the files-first launcher (the agent
      # daemon command). Files-first config (hooks/manifests) ships per-snap via
      # husarion-agent-extras/config-seed/.
      'husarion-agent/fetch-binary.sh':            usr/share/husarion-snap-common/husarion-agent/fetch-binary.sh
      'husarion-agent/launcher.sh':                usr/bin/husarion_agent_launcher.sh
      'husarion-agent/configure-snap-to-files.sh': usr/bin/configure-snap-to-files.sh
      # Minimal standalone Manage panels (Health/Info), snap-agnostic — the
      # launcher points --panels-default at usr/share/husarion-agent/panels.d.
      'husarion-agent/panels.d/*.yaml':            usr/share/husarion-agent/panels.d/
      # Content-interface chaining helpers (SPEC-content-chain).
      'husarion-agent/content-*.sh':               usr/bin/
    override-build: |
      craftctl default
      curl -L "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${CRAFT_ARCH_BUILD_FOR}" -o $CRAFT_PART_BUILD/yq
    override-prime: |
      craftctl default
      cp $CRAFT_PART_BUILD/yq $CRAFT_PRIME/usr/bin/yq
      chmod +x $CRAFT_PRIME/usr/bin/yq
      rm -rf $CRAFT_PRIME/local-ros $CRAFT_PRIME/husarion-agent
    stage:
      - "-usr/bin/start_launcher.sh"

  # Chained-agents binary + per-snap files-first config seed. The binary fetch +
  # files-first launcher ship from husarion-snap-common; only the config-seed
  # (identity + follow.yaml + the leaf network/rmw hooks + manifests) is
  # per-snap. depthai is a leaf follower (role:leaf, follows the rosbot snap's
  # :7444). SPEC-content-chain Phase 4.
  husarion-agent:
    plugin: dump
    after: [husarion-snap-common]
    source: snap/husarion-agent-extras/
    source-type: local
    build-environment:
      - HA_VERSION: "1.11.2"
    build-packages:
      - curl
    override-build: |
      set -euo pipefail
      craftctl default
      bash "${CRAFT_STAGE}/usr/share/husarion-snap-common/husarion-agent/fetch-binary.sh"
      install -Dm755 "${CRAFT_PART_BUILD}/husarion-agent" "${CRAFT_PART_INSTALL}/usr/bin/husarion-agent"
    organize:
      'config-seed/': usr/share/husarion-agent/config-seed/
