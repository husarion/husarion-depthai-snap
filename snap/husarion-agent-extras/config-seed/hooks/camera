#!/usr/bin/env python3
"""Pass-through hook for the parametric `camera` concern.

All the actual pipeline logic (i_pipeline_type derivation, subpixel/republisher
constraints for the dual-plugin depth leg, resolution/fps compilation) now
lives in the snap itself — generate_camera_params.sh, run by the configure
hook, turns driver.depth/resolution/fps/imu/ir/ip into
camera-params-autogenerated.yaml (see CLAUDE.md "camera-params: autogenerated
vs custom"). This is the ONE source of truth: cockpit and a headless
`snap set` both land on the exact same driver.* keys, so there is nothing
left for this hook to derive or compose — it just refreshes the capability
probe (for Manage's dynamic enums + visible_when gates) and mirrors each
concern field onto its matching snap key, one-to-one. It also pins
driver.camera-params back to "autogenerated" every run — Manage always drives
the generated file, even if the operator previously switched to a custom one
via a headless `snap set`.
"""
import os
import subprocess
import sys

SNAP = os.environ.get("SNAP", "")


def env(key, default=""):
    return os.environ.get(f"HUSARION_AGENT_{key}", default).strip()


def snapctl_set(k, v):
    if v != "":
        subprocess.run(["snapctl", "set", f"driver.{k}={v}"], check=False)


def run_probe():
    probe = os.path.join(SNAP, "usr", "bin", "camera-probe.py") if SNAP else "camera-probe.py"
    if os.path.exists(probe):
        subprocess.run([sys.executable, probe], check=False)


def main():
    run_probe()  # refresh caps + HAS_* flags before Manage re-renders

    snapctl_set("camera-params", "autogenerated")
    snapctl_set("name", env("NAME", "oak"))
    snapctl_set("model", env("CAMERA_MODEL"))
    snapctl_set("ip", env("IP"))
    snapctl_set("resolution", env("RGB_RESOLUTION"))
    snapctl_set("fps", env("RGB_FPS"))
    snapctl_set("depth", env("DEPTH_ENABLE"))
    snapctl_set("pointcloud", env("POINTCLOUD_ENABLE"))
    snapctl_set("imu", env("IMU_ENABLE"))
    snapctl_set("ir", env("IR_ENABLE"))

    cfg = os.path.join(SNAP, "meta", "hooks", "configure") if SNAP else ""
    if cfg and os.access(cfg, os.X_OK):
        subprocess.run([cfg], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
