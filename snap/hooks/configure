#!/bin/bash -e

# The configure hook is called every time one the following actions happen:
# - initial snap installation
# - snap refresh
# - whenever the user runs snap set|unset to change a configuration option

# Define a function to log and echo messages
source "$SNAP/usr/bin/utils.sh"

# Legacy key migration (driver.camera-model -> driver.model). Runs before
# validate_keys, so an old `snap set … driver.camera-model=…` still lands: it
# is folded into driver.model here instead of failing validation.
OLD_CAMERA_MODEL="$(snapctl get driver.camera-model)"
if [ -n "$OLD_CAMERA_MODEL" ]; then
  snapctl set driver.model="$OLD_CAMERA_MODEL"
  snapctl set driver.camera-model!
  log_and_echo "Warning: 'driver.camera-model' is deprecated — value '${OLD_CAMERA_MODEL}' migrated to 'driver.model'. Use 'snap set ${SNAP_NAME} driver.model=…' from now on."
fi

# Legacy key migration (driver.enable-pointcloud -> driver.pointcloud), same
# pattern as camera-model above.
OLD_ENABLE_POINTCLOUD="$(snapctl get driver.enable-pointcloud)"
if [ -n "$OLD_ENABLE_POINTCLOUD" ]; then
  snapctl set driver.pointcloud="$OLD_ENABLE_POINTCLOUD"
  snapctl set driver.enable-pointcloud!
  log_and_echo "Warning: 'driver.enable-pointcloud' is deprecated — value '${OLD_ENABLE_POINTCLOUD}' migrated to 'driver.pointcloud'. Use 'snap set ${SNAP_NAME} driver.pointcloud=…' from now on."
fi

# Legacy key migration (driver.camera-params=default -> autogenerated): "default"
# was the one static bundled preset; it's replaced by the always-current
# generated file (generate_camera_params.sh) — see CLAUDE.md "camera-params:
# autogenerated vs custom". Only touches the exact legacy value, never a
# custom name the operator already chose.
if [ "$(snapctl get driver.camera-params)" = "default" ]; then
  snapctl set driver.camera-params=autogenerated
  log_and_echo "Warning: 'driver.camera-params=default' is deprecated — migrated to 'autogenerated' (the equivalent, always-current generated preset)."
fi

# # Define the top-level key and the list of valid keys
VALID_DRIVER_KEYS=(
  "name"
  "model"
  "camera-params"
  "ffmpeg-params"
  "startup-delay"
  "pointcloud"
  "depth"
  "resolution"
  "fps"
  "imu"
  "ir"
  "ip"
  "rectify-rgb"
  "bitrate"
)

# common

validate_keys "driver" VALID_DRIVER_KEYS[@]

# validate driver.name
validate_regex "driver.name" '^[a-z_-]{1,10}$'

# validate driver.model — unset on fresh installs; the launcher refuses to
# start until the operator picks one (rosbot's driver.model pattern)
VALID_CAMERA_MODEL_OPTIONS=("OAK-D" "OAK-D-LITE" "OAK-1" "OAK-1-LITE" "OAK-D-PRO" "OAK-D-PRO-W")
validate_option --allow-unset "driver.model" VALID_CAMERA_MODEL_OPTIONS[@]

SUPPORTED_RANGE=(0 120)
validate_number --allow-unset "driver.startup-delay" SUPPORTED_RANGE[@]

VALID_BOOL_OPTIONS=("true" "false")
validate_option "driver.pointcloud" VALID_BOOL_OPTIONS[@]
validate_option "driver.rectify-rgb" VALID_BOOL_OPTIONS[@]

# driver.depth: overrides the preset's own camera.i_pipeline_type at launch
# (see depthai.launch.py). Defaults to false (apply_defaults.sh).
validate_option --allow-unset "driver.depth" VALID_BOOL_OPTIONS[@]

# rectify-rgb / depth / pointcloud form a strict dependency chain:
#   rectify-rgb  <-  depth  <-  pointcloud
# (PointCloudXyzrgbNode needs depth's stereo/image_raw; depth is only really
# useful — and the on-chip disparity-H.264 preview is only meaningfully
# comparable to a rectified RGB view — alongside a rectified RGB stream).
#
# A snapshot of the current snapctl state alone CANNOT tell "pointcloud=true
# just requested, depth hasn't caught up in THIS run yet" apart from "depth=false
# just requested, pointcloud is stale from an earlier run" — both produce the
# exact same {depth:false, pointcloud:true} snapshot. So this compares against
# the END state of the LAST successful configure run (persisted in
# CHAIN_STATE_FILE) to see which link actually just flipped, then cascades from
# there: a just-disabled lower link cascades OFF everything above it; a
# just-enabled higher link cascades ON everything below it. See CLAUDE.md
# "rectify-rgb / depth / pointcloud dependency chain" for worked examples.
CHAIN_STATE_FILE="${SNAP_DATA}/.camera-chain-state"
PREV_RECT=""
PREV_DEPTH=""
PREV_POINTCLOUD=""
if [ -f "$CHAIN_STATE_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CHAIN_STATE_FILE"
fi

RECT_REQUESTED="$(snapctl get driver.rectify-rgb)"
DEPTH_REQUESTED="$(snapctl get driver.depth)"
POINTCLOUD_REQUESTED="$(snapctl get driver.pointcloud)"
CAM_MODEL_FOR_DEPTH="$(snapctl get driver.model)"

# Cascade OFF: a link that just transitioned true->false disables whatever
# depends on it.
if [ "$PREV_RECT" = "true" ] && [ "$RECT_REQUESTED" = "false" ]; then
  if [ "$DEPTH_REQUESTED" = "true" ]; then
    snapctl set driver.depth=false
    DEPTH_REQUESTED=false
    log_and_echo "driver.rectify-rgb=false disables depth — set driver.depth=false automatically."
  fi
  if [ "$POINTCLOUD_REQUESTED" = "true" ]; then
    snapctl set driver.pointcloud=false
    POINTCLOUD_REQUESTED=false
    log_and_echo "driver.rectify-rgb=false disables pointcloud — set driver.pointcloud=false automatically."
  fi
fi
if [ "$PREV_DEPTH" = "true" ] && [ "$DEPTH_REQUESTED" = "false" ] && [ "$POINTCLOUD_REQUESTED" = "true" ]; then
  snapctl set driver.pointcloud=false
  POINTCLOUD_REQUESTED=false
  log_and_echo "driver.depth=false disables pointcloud — set driver.pointcloud=false automatically."
fi

# Cascade ON: a link that just transitioned (non-true)->true enables whatever
# it depends on. pointcloud also needs a stereo-capable model — verified
# against upstream depthai-ros: pointcloud.launch.py/rgbd_pcl.launch.py always
# pair PCL with an RGBD params_file, and PointCloudXyzrgbNode remaps its depth
# input from <name>/stereo/image_raw, a topic that simply doesn't exist without
# depth — so reject outright rather than cascading onto a model that can never
# satisfy it.
if [ "$PREV_POINTCLOUD" != "true" ] && [ "$POINTCLOUD_REQUESTED" = "true" ]; then
  case "$CAM_MODEL_FOR_DEPTH" in
    OAK-1 | OAK-1-LITE)
      log_and_echo "Error: driver.pointcloud=true rejected — '${CAM_MODEL_FOR_DEPTH}' has no stereo camera pair, so it can never produce depth."
      exit 1
      ;;
    *)
      if [ "$DEPTH_REQUESTED" != "true" ]; then
        snapctl set driver.depth=true
        DEPTH_REQUESTED=true
        log_and_echo "driver.pointcloud=true implies depth — set driver.depth=true automatically."
      fi
      ;;
  esac
fi
if [ "$PREV_DEPTH" != "true" ] && [ "$DEPTH_REQUESTED" = "true" ] && [ "$RECT_REQUESTED" != "true" ]; then
  snapctl set driver.rectify-rgb=true
  RECT_REQUESTED=true
  log_and_echo "driver.depth=true implies rectify-rgb — set driver.rectify-rgb=true automatically."
fi

# Stereo-capability gate: reject driver.depth=true on a model with no stereo
# pair before it ever reaches the launch file (mirrors camera-probe.py's MATRIX).
# Uses the final DEPTH_REQUESTED value — the cascades above may have changed it.
if [ "$DEPTH_REQUESTED" = "true" ]; then
  case "$CAM_MODEL_FOR_DEPTH" in
    OAK-1 | OAK-1-LITE)
      log_and_echo "Error: driver.depth=true rejected — '${CAM_MODEL_FOR_DEPTH}' has no stereo camera pair."
      exit 1
      ;;
  esac
fi

# driver.resolution / driver.fps: override rgb.i_resolution / rgb.i_fps at
# launch (depthai.launch.py). Default 720P/30 (apply_defaults.sh) — a safe,
# universal baseline (every OAK-x model supports it). Not capability-gated per
# exact value here (unlike depth/imu/ir, this isn't a binary yes/no) — an
# unsupported combo (e.g. 4K on a sensor that doesn't do it) fails at the
# driver, not at `snap set` time; the cockpit's dynamic enum (camera-probe.py's
# per-model rgb_resolution/rgb_fps lists) keeps Manage from offering it.
VALID_RESOLUTIONS=("720P" "1080P" "4K")
validate_option --allow-unset "driver.resolution" VALID_RESOLUTIONS[@]
FPS_RANGE=(1 60)
validate_number --allow-unset "driver.fps" FPS_RANGE[@]

# driver.imu / driver.ir: override camera.i_enable_imu / i_enable_ir at launch.
# Default false (apply_defaults.sh); capability-gated below.
validate_option --allow-unset "driver.imu" VALID_BOOL_OPTIONS[@]
validate_option --allow-unset "driver.ir" VALID_BOOL_OPTIONS[@]

# driver.bitrate: overrides the on-chip H.264 encoder's i_low_bandwidth_bitrate
# (generate_camera_params.sh). Default 3400000 (apply_defaults.sh). Static CBR,
# applied once at pipeline build — not runtime-adjustable (see CLAUDE.md "On-chip
# H.264 bitrate is hardcoded, static CBR"). Upper bound matches
# VideoEncoderProperties' own auto-compute ceiling for 2160p30 (20Mbps) — the
# highest bitrate this snap could plausibly need at its max supported
# resolution. Lower bound (500000) is a conservative practical floor against a
# degenerate near-zero setting, not tied to a specific upstream reference point.
BITRATE_RANGE=(500000 20000000)
validate_number --allow-unset "driver.bitrate" BITRATE_RANGE[@]

IMU_REQUESTED="$(snapctl get driver.imu)"
IR_REQUESTED="$(snapctl get driver.ir)"
CAM_MODEL_FOR_SENSORS="$(snapctl get driver.model)"
if [ "$IMU_REQUESTED" = "true" ]; then
  case "$CAM_MODEL_FOR_SENSORS" in
    OAK-1 | OAK-1-LITE)
      log_and_echo "Error: driver.imu=true rejected — '${CAM_MODEL_FOR_SENSORS}' has no IMU."
      exit 1
      ;;
  esac
fi
if [ "$IR_REQUESTED" = "true" ]; then
  case "$CAM_MODEL_FOR_SENSORS" in
    OAK-D-PRO | OAK-D-PRO-W) ;;
    *)
      log_and_echo "Error: driver.ir=true rejected — '${CAM_MODEL_FOR_SENSORS}' has no IR projector."
      exit 1
      ;;
  esac
fi

# driver.ip: PoE target address, overrides camera.i_ip at launch. No default —
# unset means USB (the common case).
validate_ipv4_addr --allow-unset "driver.ip"

# export LD_LIBRARY_PATH=$SNAP/usr/lib/$(uname -m)-linux-gnu/pulseaudio:$SNAP/usr/lib/$(uname -m)-linux-gnu/blas:$SNAP/usr/lib/$(uname -m)-linux-gnu/lapack:$LD_LIBRARY_PATH

# camera-params: autogenerated vs custom (see CLAUDE.md). "autogenerated" (the
# default) is regenerated from depth/resolution/fps/imu/ir/ip/bitrate on EVERY
# configure run — always current, no separate compose step to fall out of
# sync. Anything else is a hand-authored file: fully hands-off, the driver.*
# overrides above stop having any effect (logged so it's never a silent no-op).
CAMERA_PARAMS_VALUE="$(snapctl get driver.camera-params)"
if [ "$CAMERA_PARAMS_VALUE" = "autogenerated" ]; then
  "$SNAP/usr/bin/generate_camera_params.sh"
else
  log "driver.camera-params='${CAMERA_PARAMS_VALUE}' (custom) — depth/resolution/fps/imu/ir/ip/bitrate are not applied; that file's own values are used as-is."
fi

# validate driver.camera-params and driver.ffmpeg-params (live in $SNAP_DATA;
# validate_config_param from utils.sh hardcodes $SNAP_COMMON, so we check inline)
for param in camera-params ffmpeg-params; do
    value=$(snapctl get "driver.${param}")
    file="${SNAP_DATA}/${param}-${value}.yaml"
    if [ ! -f "$file" ]; then
        available=$(ls "${SNAP_DATA}/" 2>/dev/null | grep -oE "${param}-.+\.yaml$" | sed -E "s/^${param}-(.*)\.yaml$/\1/" | tr '\n' ' ')
        log_and_echo "'${value}' is not a valid value for 'driver.${param}'. There is no '${file}'. Available options: ${available}"
        exit 1
    fi
done

# Populate the files-first `camera` concern's capability flags so Manage renders
# the right per-capability cards — the depth/imu/ir cards are gated (visible_when)
# on HAS_STEREO/HAS_IMU/HAS_IR. These mirror camera-probe.py's static matrix by
# camera class; the probe (run by the concern's apply hook, which has python via
# the ROS env — snap hooks have none) refines them and fills the resolution/fps
# dynamic-enum options on first apply. Guard on the agent having seeded its
# config-root: the install-time configure runs BEFORE the agent's first start,
# and creating config/ early would make the launcher's IF-ABSENT seed skip
# network/rmw. The deploy's `snap set driver.model` re-fires this with
# config/ present. Writes files only (no snapctl set) so it can't disturb the
# pipeline chosen via driver.camera-params.
if [ -d "${SNAP_COMMON}/husarion-agent/config" ]; then
    # OAK-D-PRO fallback is a deliberate cockpit prefill: before the operator
    # declares driver.model, Manage still needs plausible capability cards +
    # dropdown options. The launcher gate (not this) enforces the declaration.
    cam_model="$(snapctl get driver.model)"; : "${cam_model:=OAK-D-PRO}"
    case "$cam_model" in
        OAK-1|OAK-1-LITE)      has_stereo=false; has_ir=false; has_imu=false ;;
        OAK-D|OAK-D-LITE)      has_stereo=true;  has_ir=false; has_imu=true  ;;
        OAK-D-PRO|OAK-D-PRO-W) has_stereo=true;  has_ir=true;  has_imu=true  ;;
        *)                     has_stereo=true;  has_ir=false; has_imu=true  ;;
    esac
    cam_dir="${SNAP_COMMON}/husarion-agent/config/camera"
    mkdir -p "$cam_dir"
    cam_env="${cam_dir}/local.env"
    # Preserve any other local-scope keys (e.g. MXID/IP); rewrite only ours.
    keep="$(grep -vE '^(HAS_STEREO|HAS_IR|HAS_IMU|DETECTED_MODEL)=' "$cam_env" 2>/dev/null || true)"
    {
        [ -n "$keep" ] && printf '%s\n' "$keep"
        printf 'HAS_STEREO=%s\nHAS_IR=%s\nHAS_IMU=%s\nDETECTED_MODEL=%s\n' \
            "$has_stereo" "$has_ir" "$has_imu" "$cam_model"
    } > "$cam_env"
    # Mirror the probe's per-model res/fps option lists into $SNAP_DATA/caps so
    # the rgb/depth resolution + fps dynamic-enum dropdowns are populated. The
    # python probe refines these (incl. live mxid detection) on the concern's
    # first apply.
    write_caps() { d="${SNAP_DATA}/caps/$1"; rm -rf "$d"; mkdir -p "$d"; shift; for v in "$@"; do : > "${d}/${v}.opt"; done; }
    write_caps model OAK-1 OAK-1-LITE OAK-D OAK-D-LITE OAK-D-PRO OAK-D-PRO-W
    case "$cam_model" in OAK-1-LITE|OAK-D-LITE) rgb_fps_opts=(30) ;; *) rgb_fps_opts=(30 60) ;; esac
    write_caps rgb_resolution 720P 1080P 4K
    write_caps rgb_fps "${rgb_fps_opts[@]}"
    log "camera concern caps: model=$cam_model stereo=$has_stereo imu=$has_imu ir=$has_ir"
fi

# depthai_ros driver is a plain rclcpp node — RMW-agnostic, including zenoh.
# The husarion-snap-common zenoh gate exists for snaps that pair zenoh with a
# non-zenoh bridge (e.g. micro_ros_agent); depthai has no such bridge, so opt in.
export HSC_ALLOW_ZENOH=1

"$SNAP/usr/bin/configure_hook_ros.sh"

# Persist the final, post-cascade rectify-rgb/depth/pointcloud state for the
# next run's before/after diff (see the CHAIN_STATE_FILE block above). This
# MUST be the last thing before the restart below: snapd only commits this
# run's `snapctl set` calls once the hook exits 0, but this file write is a
# plain filesystem write outside that transaction. Persisting it any earlier
# — before the imu/ir gate, resolution/fps/ip validation, or the
# camera-params/ffmpeg-params existence check, all of which can still `exit 1`
# — would leave the chain state claiming a transition that snapd itself
# rolled back, desyncing it from the actually-committed driver.* values.
{
  echo "PREV_RECT=${RECT_REQUESTED}"
  echo "PREV_DEPTH=${DEPTH_REQUESTED}"
  echo "PREV_POINTCLOUD=${POINTCLOUD_REQUESTED}"
} > "$CHAIN_STATE_FILE"

# Restart the daemon with the new config. snapctl restart is synchronous and
# prints its own "Waiting for ... to stop." progress line — that's snapd's,
# not ours, and only covers the stop half. Confirm the whole restart finished
# with log_and_echo (not log) so the operator actually sees it on their
# terminal, instead of being left looking at a lone "to stop" line.
if snapctl services "${SNAP_NAME}.daemon" | grep -qw enabled; then
  snapctl restart "${SNAP_NAME}.daemon"
  log_and_echo "Restarted ${SNAP_NAME}.daemon."
fi
