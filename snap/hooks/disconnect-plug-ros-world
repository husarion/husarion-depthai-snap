source $SNAP/usr/bin/utils.sh

# The mount is still live during this hook, so configure would rejoin: render
# the ros.* env directly. Never fail: a failing disconnect hook would block
# removing the rosbot snap.
if ! $SNAP/usr/bin/configure_hook_ros.sh; then
  log_and_echo "Left the robot world, but the ros.* keys are invalid; fix them with 'snap set ${SNAP_NAME} ros.…'."
fi

if snapctl services ${SNAP_NAME}.daemon | grep -qw enabled; then
  snapctl restart ${SNAP_NAME}.daemon
fi
