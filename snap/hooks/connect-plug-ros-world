source $SNAP/usr/bin/robot_world.sh

# The content mount is live here. Join directly instead of running configure
# (camera validation can fail and would then undo the connection).
hsc_join_robot_world "${SNAP_COMMON}/ros-world" || true

if snapctl services ${SNAP_NAME}.daemon | grep -qw enabled; then
  snapctl restart ${SNAP_NAME}.daemon
fi
